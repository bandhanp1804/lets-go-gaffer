# The Next.js web app as a standalone Node server. Build from the repository root:
#   docker build -f deploy/docker/Dockerfile.web -t gaffer-web .
FROM node:22.23.4-alpine3.24 AS deps
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci

FROM node:22.23.4-alpine3.24 AS build
WORKDIR /web
COPY --from=deps /web/node_modules ./node_modules
COPY web ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22.23.4-alpine3.24
WORKDIR /web
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
# standalone holds the server and only the modules it needs; static files and public assets
# are copied beside it, as Next expects.
COPY --from=build --chown=node:node /web/.next/standalone ./
COPY --from=build --chown=node:node /web/.next/static ./.next/static
USER node
EXPOSE 3000
CMD ["node", "server.js"]
