# Copy to deploy/azure.env (gitignored) and fill in. Read by deploy/scripts/deploy.sh.

# Let's Encrypt account email (certificate expiry notices).
ACME_EMAIL=you@example.com

# The GitHub OAuth app that guards the site. Create it after `deploy.sh infra` prints the host:
# GitHub > Settings > Developer settings > OAuth Apps > New OAuth App
#   Homepage URL:               https://<host>
#   Authorization callback URL: https://<host>/dex/callback   (sign-in goes through Dex)
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# Google and Microsoft sign-in (docs/sign-in.md). Each is offered only once its pair is filled in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Anyone can sign in; these emails are never held to the daily limits. Use the address each
# person signs in with (for GitHub, their primary GitHub email).
GAFFER_OWNERS=
