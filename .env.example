# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Postgres from deploy/docker/docker-compose.yml (host port 5433).
GAFFER_DSN=postgres://gaffer:gaffer@localhost:5433/gaffer?sslmode=disable
# Integration tests TRUNCATE this database; its name must end in _test.
GAFFER_TEST_DSN=postgres://gaffer:gaffer@localhost:5433/gaffer_test?sslmode=disable
GAFFER_MIGRATIONS=migrations

# Voyage AI embeddings (https://www.voyageai.com).
VOYAGE_API_KEY=
# Requests per minute. 3 is the limit for accounts without a payment method on
# file (free tokens still apply either way); raise it after adding one.
VOYAGE_RPM=3

# Anthropic API for the router and answers (https://console.anthropic.com).
ANTHROPIC_API_KEY=
