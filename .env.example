# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Postgres from deploy/docker/docker-compose.yml (host port 5433).
GAFFER_DSN=postgres://gaffer:gaffer@localhost:5433/gaffer?sslmode=disable
# Integration tests TRUNCATE this database; its name must end in _test.
GAFFER_TEST_DSN=postgres://gaffer:gaffer@localhost:5433/gaffer_test?sslmode=disable
GAFFER_MIGRATIONS=migrations

# Your FPL team id, for `gaffer team`. Open the Points page on the FPL site and read
# it from the address: .../entry/<TEAM_ID>/event/<N>
GAFFER_TEAM_ID=

# Voyage AI embeddings (https://www.voyageai.com).
VOYAGE_API_KEY=
# Requests per minute. 3 is the limit for accounts without a payment method on
# file (free tokens still apply either way); raise it after adding one.
VOYAGE_RPM=3

# Anthropic API for the router and answers (https://console.anthropic.com).
ANTHROPIC_API_KEY=

# --- Optional: your logged-in FPL session, so the tool can read your pending transfers
# (not built yet). Treat these like a password: anyone holding them can act as you on
# FPL until they expire. Never paste them into chat or commit them.
# How to get them: log in at fantasy.premierleague.com, open the Transfers page,
# DevTools (Cmd+Option+I) > Network > filter "my-team" > reload > click the
# my-team request > Request Headers > right-click "cookie" > Copy value.
# Leave blank to use only FPL public data (plus -swap).
FPL_COOKIE=
# Only if the my-team request also has an "x-api-authorization" header; otherwise leave blank.
FPL_AUTH_HEADER=
