# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Postgres from deploy/docker/docker-compose.yml (host port 5433).
GAFFER_DSN=postgres://gaffer:gaffer@localhost:5433/gaffer?sslmode=disable
# Integration tests TRUNCATE this database; its name must end in _test.
GAFFER_TEST_DSN=postgres://gaffer:gaffer@localhost:5433/gaffer_test?sslmode=disable
GAFFER_MIGRATIONS=migrations

# Optional: a default team id, used by `gaffer team`/`lineup` and shown in the web app until you
# enter another (the web app can load any team). Open the Points page on the FPL site and read it
# from the address: .../entry/<TEAM_ID>/event/<N>
GAFFER_TEAM_ID=

# Voyage AI embeddings (https://www.voyageai.com).
VOYAGE_API_KEY=
# Requests per minute. 3 is the limit for accounts without a payment method on
# file (free tokens still apply either way); raise it after adding one.
VOYAGE_RPM=3

# Anthropic API for the router and answers (https://console.anthropic.com).
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-5-5: questions are short and Go does the computing.
# Use claude-sonnet-5-5 for richer answers at a higher price.
ANTHROPIC_MODEL=

# --- Optional: your logged-in FPL session, so the tool reads your LIVE squad (including
# transfers made since the last deadline) with FPL's exact selling prices and transfer counts.
# Only the x-api-authorization value is needed; the cookie is not.
# Treat it like a password: it lets anyone act as you on FPL until it expires. It lasts about
# an hour, so copy a fresh one before a session of use. Never paste it into chat or commit it.
# How: log in at fantasy.premierleague.com, open the Transfers page, DevTools (Cmd+Option+I) >
# Network > filter "my-team" > reload > click the my-team request > Request Headers >
# right-click "x-api-authorization" > Copy value (it starts with "Bearer ").
# Leave blank to use FPL's public data only (the squad as of the last deadline; add
# -swap "Out>In" for moves you have made since).
FPL_AUTH_HEADER=
